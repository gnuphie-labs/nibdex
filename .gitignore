/target

# SQLite (FTS5 index + WAL/SHM sidecars)
*.db
*.db.bak*
*.bak-*
# Pre-upgrade db copies and the adoption-baseline dumps. Both are generated,
# both are machine-specific, and both were left untracked — which stalls the
# release gate at step 0 rather than at anything that matters.
*.db.pre-*
nibdex-baseline-*.txt
*.db-journal
*.db-wal
*.db-shm

# Metrics sink output (§5.5)
*.jsonl

# Day 10 self-dogfood — daemon live-state (PID + stderr/stdout log)
# (cold_index_*.log IS committed as one-shot evidence; daemon.log mutates)
# Glob covers per-machine suffixed variants like daemon-home.log
dogfood/daemon*.pid
dogfood/daemon*.log

# Third-party reference docs (clipped articles, vendor PDFs) — local-only, never commit
# (publication-bound repo + copyrighted content risk)
docs/*.pdf

# Secrets — NEVER commit (defense in depth)
.env
.env.*
*.key

# Per-user domain map (docs/SESSION_SCOPE_DESIGN.md §0) — a workspace-local file
# naming the user's real domains/projects; never part of nibdex's own repo.
.nibdex-domains.toml
*.pem
*.crt
*.cer
*.p12
*.pfx
*.gpg
*.age
*.asc
**/secrets/
**/.secrets/
*.sops.yaml
.aws/
.gcloud/
.kube/config
id_rsa
id_ed25519
**/id_rsa*
**/id_ed25519*

# OS
.DS_Store

# Day 10 self-dogfood — local metrics-export candidates (IP-scrubbed, hand-shared; not tracked)
dogfood/nibdex-metrics-export-*.json

# read-rank labelled sets. Real corpus paths and real queries — generated,
# machine-local, and never published. This repo is cut to a public tree, so an
# untracked-and-unignored file here is one `git add -A` from travelling.
dogfood/labelled-read-rank-*.json
__pycache__/
